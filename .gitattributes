# Set default behavior to automatically normalize line endings to LF
* text=auto eol=lf

# Explicitly ensure code, markdown, and config files use LF
*.py text eol=lf
*.md text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.toml text eol=lf
*.json text eol=lf
*.tex text eol=lf
*.bib text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.tif binary
*.tiff binary
*.parquet binary
*.gz binary
