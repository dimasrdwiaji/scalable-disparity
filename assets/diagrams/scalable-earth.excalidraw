      "updated": 1791812042475,
      "created": 1791809867407,
      "link": null,
      "locked": false,
      "text": "Peraturan\n1. Time budget = cap. ~2 jam per minggu\n2. Potong scope sebelum deadline\n3. Kalo pas ga bisa kabarin aja\n4. Meeting harus kurang dari 30 menit\n5. Semua keputusan ditulis\n6. Di akhir meeting itu harus ada -> rangkuman\n& action item",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Peraturan\n1. Time budget = cap. ~2 jam per minggu\n2. Potong scope sebelum deadline\n3. Kalo pas ga bisa kabarin aja\n4. Meeting harus kurang dari 30 menit\n5. Semua keputusan ditulis\n6. Di akhir meeting itu harus ada -> rangkuman & action item",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
